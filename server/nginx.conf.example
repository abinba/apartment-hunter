# /etc/nginx/sites-available/apartment-hunter
#
# Replace HOSTNAME everywhere with your sslip.io name — your public IP with
# dashes instead of dots, e.g. 51-77-203-14.sslip.io
#
# Do not add CORS headers here. FastAPI already sends them, driven by
# CORS_ORIGINS in .env, and a second set makes browsers reject the response
# ("multiple values in Access-Control-Allow-Origin").

# ---------------------------------------------------------------- port 80
# Kept open permanently: Let's Encrypt re-validates over HTTP-01 at renewal.
server {
    listen 80;
    listen [::]:80;
    server_name HOSTNAME;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------- port 443
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name HOSTNAME;

    # HTTP/2 is optional here — this is a small JSON API, not a page load, so it
    # gains nothing measurable. If you want it anyway, the directive differs by
    # version and using the wrong one is a hard config error:
    #   nginx  < 1.25.1 :  listen 443 ssl http2;   (on the listen line above)
    #   nginx >= 1.25.1 :  http2 on;               (as its own directive)
    # Check with: nginx -v

    ssl_certificate     /etc/letsencrypt/live/HOSTNAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/HOSTNAME/privkey.pem;

    # Spelled out rather than `include /etc/letsencrypt/options-ssl-nginx.conf`,
    # which only exists if the certbot *nginx plugin* installed it — with
    # `certonly --webroot` it is absent and nginx refuses to start.
    # ECDHE-only, so no ssl_dhparam file is needed either.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The scraper. Trailing slashes on both sides strip the prefix, so the
    # container sees /api/scrape rather than /apartment-hunter/api/scrape.
    location /apartment-hunter/ {
        proxy_pass         http://127.0.0.1:8080/;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # A listing with twelve photographs takes a few minutes end to end.
        # The default 60s would cut the reconcile pass off mid-flight.
        proxy_connect_timeout 15s;
        proxy_send_timeout   300s;
        proxy_read_timeout   300s;

        proxy_buffering off;          # progress polling wants to be prompt
        client_max_body_size 2m;
    }

    # Anything else on this host is not yours to serve.
    location / {
        return 404;
    }
}
