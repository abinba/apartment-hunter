# ---------------------------------------------------------------- credentials
# Real secrets. This file is gitignored; copy to .env and fill in.
SCRAPINGBEE_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- behaviour
ANTHROPIC_MODEL=claude-sonnet-5
MAX_PHOTOS=12
PHOTO_MAX_PX=1024

# ---------------------------------------------------------------- access
# Firebase project whose ID tokens are accepted.
FIREBASE_PROJECT_ID=apartment-hunter-41fd6
# Only these Google accounts may scrape. LEAVE THIS SET — an empty value lets
# any signed-in Google account spend your ScrapingBee and Anthropic credit.
ALLOWED_EMAILS=abror.ruzibayev@gmail.com
# Where the browser calls from. Include localhost while developing.
CORS_ORIGINS=https://abinba.github.io,http://localhost:8000

# ---------------------------------------------------------------- limits
DAILY_JOB_CAP=60
MAX_CONCURRENT_JOBS_PER_USER=3
JOB_TTL_SECONDS=1800
