# ---------------------------------------------------------------- secrets
# These are the ones that actually matter. The service-account JSON bypasses
# every rule in firestore.rules; server/.env holds the ScrapingBee and
# Anthropic keys, which bill by usage and have no origin restriction.
server/.env
server/.env.*
!server/.env.example
config.js
*serviceAccount*.json
*-firebase-adminsdk-*.json
apartment-hunter-*.json
.firebase/
firebase-debug.log
firestore-debug.log

