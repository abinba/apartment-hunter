# Service-account / admin credentials — must never be committed.
# These bypass Firestore security rules entirely.
*serviceAccount*.json
*-firebase-adminsdk-*.json
apartment-hunter-*.json
firebase-debug.log
.firebase/

# Real config with keys in it. Commit config.example.js instead and enter the
# values in the page once per browser — they land in local storage.
config.js

# Local data dumps
*.local.json
node_modules/
.DS_Store

# Server secrets — ScrapingBee and Anthropic keys live here
server/.env
